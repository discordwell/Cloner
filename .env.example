# Cloner Environment Variables Template
# Copy this file to .env and fill in your actual values

# Voice Cloning API Keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
RESEMBLE_API_KEY=your_resemble_api_key_here

# Lip-sync Video Generation (Atlas / North Model Labs)
ATLAS_API_KEY=your_atlas_api_key_here

# Meeting Platform Credentials (if needed)
GOOGLE_MEET_EMAIL=your_email@gmail.com
GOOGLE_MEET_PASSWORD=your_password_here

# Optional: Zoom credentials
ZOOM_EMAIL=your_email@example.com
ZOOM_PASSWORD=your_password_here

# Autopitch — image search (pick one)
BING_IMAGE_SEARCH_KEY=your_bing_image_search_key_here
SERPAPI_KEY=your_serpapi_key_here

# Autopitch — optional speaker diarization for voice-sample cleanup
HUGGINGFACE_TOKEN=your_hf_token_here

# Autopitch — LLM keys (reuses OPENAI_API_KEY/ANTHROPIC_API_KEY above)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Project Settings
DEBUG=false
LOG_LEVEL=INFO
